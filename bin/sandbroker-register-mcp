#!/usr/bin/env python3
"""Register one MCP server per vault with Claude Code.

Run as your normal user, not root: it edits ~/.claude.json, which is yours.

Each vault becomes its own MCP server, so the tools arrive already namespaced --
`mcp__sandbroker-dev__run` versus `mcp__sandbroker-production__run`. An agent
therefore cannot reach Production by passing a different argument; it has to
call a different tool, which is visible in the transcript and in permissions.
"""

import argparse
import json
import os
import shutil
import sys

CONFIG = os.path.expanduser("~/.claude.json")
BROKER = "/usr/local/bin/sandbroker"

# The proof-of-concept registration. Removed so its tools stop being offered
# alongside the new ones.
LEGACY = ("sandbroker",)


def load_vaults(path):
    with open(path, "r", encoding="utf-8") as fh:
        return sorted(json.load(fh).get("vaults", {}))


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--config",
                        default=os.environ.get("SANDBROKER_CONFIG",
                                               "/opt/sandbroker/etc/sandbroker.json"))
    parser.add_argument("--claude-config", default=CONFIG)
    parser.add_argument("--broker", default=BROKER)
    parser.add_argument("--dry-run", action="store_true")
    args = parser.parse_args()

    try:
        vaults = load_vaults(args.config)
    except (OSError, ValueError) as exc:
        sys.stderr.write("cannot read %s: %s\n" % (args.config, exc))
        return 1
    if not vaults:
        sys.stderr.write("no vaults in %s\n" % args.config)
        return 1

    try:
        with open(args.claude_config, "r", encoding="utf-8") as fh:
            data = json.load(fh)
    except (OSError, ValueError) as exc:
        sys.stderr.write("cannot read %s: %s\n" % (args.claude_config, exc))
        return 1

    servers = data.setdefault("mcpServers", {})
    removed, added = [], []

    for name in LEGACY:
        if name in servers:
            del servers[name]
            removed.append(name)

    for vault in vaults:
        name = "sandbroker-%s" % vault.lower()
        servers[name] = {
            "type": "stdio",
            "command": args.broker,
            "args": ["connect", "--vault", vault],
            "env": {},
        }
        added.append((name, vault))

    if args.dry_run:
        print(json.dumps({"would_remove": removed,
                          "would_add": [n for n, _ in added]}, indent=2))
        return 0

    # Back up first: ~/.claude.json holds all of Claude Code's state, not just
    # this, and clobbering it would cost far more than this script is worth.
    backup = args.claude_config + ".sandbroker-backup"
    shutil.copy2(args.claude_config, backup)

    tmp = args.claude_config + ".tmp"
    with open(tmp, "w", encoding="utf-8") as fh:
        json.dump(data, fh, indent=2)
    os.replace(tmp, args.claude_config)

    for name in removed:
        print("removed  %s (proof-of-concept)" % name)
    for name, vault in added:
        print("added    %s -> %s connect --vault %s" % (name, args.broker, vault))
    print("\nbackup:  %s" % backup)
    print("Restart Claude Code to pick up the change.")
    return 0


if __name__ == "__main__":
    sys.exit(main())
