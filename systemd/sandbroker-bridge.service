[Unit]
# A USER unit, deliberately. It must run as the human, because the queue
# directory's access control is uid ownership: the sandboxed client is the same
# uid and gets in that way, since the sandbox collapses supplementary groups to
# `nogroup` and the claude-broker membership is not available inside.
Description=Relay sandboxed MCP clients to the sandbroker sockets
Documentation=https://github.com/312-dev/sandbroker
After=default.target

[Service]
Type=exec
# Plain exec, no `sg`. The systemd --user manager inherits the login session's
# groups, so it already has claude-broker and can reach the sockets. Wrapping
# this in `sg` would need setuid, which NoNewPrivileges below correctly forbids
# -- and the wrapper was never necessary. If this ever fails with a permission
# error on the socket, the cause is a --user manager that predates the group
# grant: log out and back in.
ExecStart=/usr/local/bin/sandbroker bridge
Restart=always
RestartSec=2

# It holds no credentials and makes no decisions: it moves bytes between a
# directory this uid already owns and a socket this uid could already open.
NoNewPrivileges=yes
UMask=0077

[Install]
WantedBy=default.target
