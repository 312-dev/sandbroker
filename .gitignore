__pycache__/
*.pyc
.pytest_cache/

# Linked git worktrees that agent sessions create in-tree. They contain a full
# second checkout, so an unguarded `git add -A` commits the repo into itself.
.claude/worktrees/

# Zero-byte placeholders the Claude Code sandbox creates as bind-mount targets
# when an agent works in this directory. They are empty, but an empty .mcp.json
# is reported by Claude Code as "MCP config is not a valid JSON", so they are
# actively unhelpful as well as noise.
.bashrc
.bash_profile
.zshrc
.zprofile
.profile
.gitconfig
.ripgreprc
.gitmodules
.mcp.json
.idea
.vscode

# Zero-byte bind-mount placeholders a sandboxed agent session creates in-tree.
# They were committed once by accident; stow-style empties are not project files.
.claude/agents
.claude/commands
